---
import type { SiteConfig } from '../../lib/settingDefs';
import { telHref } from '../../lib/text';

interface Props {
  site: SiteConfig;
  menu: { title: string; url: string }[];
}

const { site, menu } = Astro.props;

const socials = [
  ['Facebook', site['social.facebook']],
  ['Instagram', site['social.instagram']],
  ['YouTube', site['social.youtube']],
  ['TikTok', site['social.tiktok']],
  ['Zalo', site['social.zalo']],
].filter(([, url]) => url);

const phone = site['company.phone'];
const email = site['company.email'];
const address = site['company.address'];
const copyright = site['footer.text'] || `© ${new Date().getFullYear()} ${site['company.name']}`;
---
<footer class="bg-ink text-paper/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-5">
      <p class="font-serif text-2xl text-paper">{site['company.name']}</p>
      {site['company.tagline'] && <p class="mt-2 max-w-xs text-small">{site['company.tagline']}</p>}
    </div>

    {menu.length > 0 && (
      <nav class="lg:col-span-2" aria-label="Chân trang">
        <ul class="space-y-2 text-small">
          {menu.map((item) => <li><a href={item.url} class="hover:text-paper">{item.title}</a></li>)}
        </ul>
      </nav>
    )}

    <div class="space-y-2 text-small lg:col-span-3">
      {address && <p class="whitespace-pre-line">{address}</p>}
      {phone && <p><a href={telHref(phone)} class="hover:text-paper">{phone}</a></p>}
      {email && <p><a href={`mailto:${email}`} class="hover:text-paper">{email}</a></p>}
      {site['company.hours'] && <p>{site['company.hours']}</p>}
    </div>

    {socials.length > 0 && (
      <ul class="space-y-2 text-small lg:col-span-2">
        {socials.map(([label, url]) => <li><a href={url} rel="noopener" class="hover:text-paper">{label}</a></li>)}
      </ul>
    )}
  </div>
  <div class="border-t border-paper/15">
    <p class="mx-auto max-w-6xl px-4 py-5 text-caption text-paper/60 sm:px-6">{copyright}</p>
  </div>
</footer>

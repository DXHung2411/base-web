---
import { paragraphs } from '../../../lib/text';
import type { SectionProps } from '../../../types/sections';
import Img from '../../ui/Img.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

type Props = SectionProps<'about'>;
const { id, title, subtitle, content, settings } = Astro.props;
const { quote, quoteAuthor, image, highlights = [] } = settings;
---
<section id={id} class="py-20 lg:py-28">
  <div class="mx-auto grid max-w-6xl gap-x-16 gap-y-10 px-4 sm:px-6 lg:grid-cols-12 lg:grid-rows-[auto_1fr]">
    <SectionHeading title={title} subtitle={subtitle} class="lg:col-span-6 lg:row-start-1" />

    {(image?.src || quote) && (
      <figure class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
        {image?.src && <Img src={image.src} alt={image.alt} width={720} height={960} class="aspect-[3/4] rounded-media" />}
        {quote && (
          <blockquote class:list={['border-l-2 border-accent pl-5', image?.src && 'mt-8']}>
            <p class="font-serif text-2xl italic leading-snug">{quote}</p>
            {quoteAuthor && <footer class="mt-3 text-small text-muted">{quoteAuthor}</footer>}
          </blockquote>
        )}
      </figure>
    )}

    <div class="lg:col-span-6 lg:row-start-2">
      <div class="max-w-prose space-y-4 text-ink/80">
        {paragraphs(content).map((text) => <p>{text}</p>)}
      </div>
      {highlights.length > 0 && (
        <ul class="mt-8 space-y-3 border-t border-ink/15 pt-6 text-small">
          {highlights.map((item) => <li class="before:mr-3 before:text-accent before:content-['—']">{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>

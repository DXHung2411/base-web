---
import type { SectionProps } from '../../../types/sections';
import Img from '../../ui/Img.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

type Props = SectionProps<'services'>;
const { id, title, subtitle, settings } = Astro.props;
const { items = [] } = settings;

// Images differ in proportion and every second column sits lower, so the strip reads as a composition.
const crops = ['aspect-[4/5]', 'aspect-square', 'aspect-[3/4]', 'aspect-[5/6]'];
---
<section id={id} class="py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading title={title} subtitle={subtitle} class="mb-10 max-w-2xl lg:mb-14" />
    <ul class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] lg:items-start lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0">
      {items.map((item, index) => (
        <li class:list={['w-[72%] shrink-0 snap-start sm:w-[44%] lg:w-auto', index % 2 === 1 && 'lg:mt-14']}>
          {item.image?.src && (
            <Img src={item.image.src} alt={item.image.alt} width={640} height={800} class:list={['rounded-media', crops[index % crops.length]]} />
          )}
          <h3 class="mt-4 text-h3">{item.title}</h3>
          {item.description && <p class="mt-1.5 text-small text-ink/70">{item.description}</p>}
          {item.href && <a href={item.href} class="mt-3 inline-block text-small underline decoration-1 underline-offset-[6px] hover:text-accent">Xem chi tiết</a>}
        </li>
      ))}
    </ul>
  </div>
</section>

---
import type { SectionProps } from '../../../types/sections';
import SectionHeading from '../../ui/SectionHeading.astro';

type Props = SectionProps<'faq'>;
const { id, title, subtitle, settings } = Astro.props;
const { items = [] } = settings;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<section id={id} class="py-16 lg:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-x-12">
    <SectionHeading title={title} subtitle={subtitle} class="lg:sticky lg:top-24 lg:col-span-4 lg:self-start" />
    <div class="border-b border-ink/15 lg:col-span-7 lg:col-start-6">
      {items.map((item) => (
        <details class="faq-item border-t border-ink/15">
          <summary class="flex items-start justify-between gap-6 py-5 font-medium">{item.question}</summary>
          <p class="max-w-prose whitespace-pre-line pb-6 text-ink/75">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
  {items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
</section>

---
import type { SectionProps } from '../../../types/sections';
import SectionHeading from '../../ui/SectionHeading.astro';

type Props = SectionProps<'features'>;
const { id, title, subtitle, settings } = Astro.props;
const { items = [] } = settings;
---
<section id={id} class="py-16 lg:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-x-12">
    <SectionHeading title={title} subtitle={subtitle} class="lg:sticky lg:top-24 lg:col-span-4 lg:self-start" />
    <ol class="lg:col-span-7 lg:col-start-6">
      {items.map((item, index) => (
        <li class="grid gap-x-6 border-t border-ink/15 py-7 sm:grid-cols-[3rem_1fr] last:border-b">
          <span class="font-serif text-xl tabular-nums text-muted">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-h3">{item.title}</h3>
            <p class="mt-2 max-w-prose text-ink/70">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicPage, getPublicSettings } from '../lib/api';
import { getSiteConfig } from '../lib/settingDefs';

const site = getSiteConfig(await getPublicSettings());
const homeSlug = site['site.homeSlug'];
const requested = Astro.params.slug;

// The home page lives at "/", so its own slug is not a second public URL.
if (requested === homeSlug) return Astro.redirect('/', 301);

const slug = requested ?? homeSlug;
const page = await getPublicPage(slug);
if (!page) return Astro.rewrite('/404');

// Content is edited in the CMS: let browsers revalidate, and let a CDN serve it briefly.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
---
<BaseLayout
  site={site}
  title={page.seo?.metaTitle || page.title}
  description={page.seo?.metaDescription || page.description}
  path={requested ? `/${slug}` : '/'}
  menu={page.menu}
  seo={page.seo}
>
  <SectionRenderer sections={page.sections} site={site} />
</BaseLayout>

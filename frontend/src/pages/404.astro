---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getPublicSettings } from '../lib/api';
import { getSiteConfig } from '../lib/settingDefs';

// The error page must still render when the API is unavailable.
const site = getSiteConfig(await getPublicSettings().catch(() => ({})));
Astro.response.status = 404;
---
<BaseLayout site={site} title={`Không tìm thấy trang · ${site['company.name']}`} path="/404" menu={[]} noindex>
  <div class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <p class="text-caption uppercase text-muted">404</p>
    <h1 class="mt-3 text-display">Không tìm thấy trang này</h1>
    <p class="mt-4 max-w-prose text-lead text-ink/70">Đường dẫn có thể đã thay đổi hoặc trang chưa được xuất bản.</p>
    <Button href="/" class="mt-8">Về trang chủ</Button>
  </div>
</BaseLayout>

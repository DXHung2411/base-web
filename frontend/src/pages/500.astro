---
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSettings } from '../lib/api';
import { getSiteConfig } from '../lib/settingDefs';

// This page is shown when something failed, possibly the API itself, so it must not depend on it.
const site = getSiteConfig(await getPublicSettings().catch(() => ({})));
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout site={site} title={`Có lỗi xảy ra · ${site['company.name']}`} path="/500" menu={[]} noindex>
  <div class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <p class="text-caption uppercase text-muted">500</p>
    <h1 class="mt-3 text-display">Trang tạm thời không tải được</h1>
    <p class="mt-4 max-w-prose text-lead text-ink/70">Xin thử lại sau ít phút.</p>
    <Button href="/" class="mt-8">Tải lại trang chủ</Button>
  </div>
</BaseLayout>

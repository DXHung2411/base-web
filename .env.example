# Used by docker-compose.yml. Copy to .env (never commit .env) and replace the values.

# SQL Server "sa" password: 8+ characters with upper/lower case, digits and symbols.
SQL_SA_PASSWORD=ChangeMe_Str0ng!

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Password of the first admin account (username: admin). Change it after the first login.
ADMIN_PASSWORD=

# Public address of the website, and of the API as seen from a browser.
SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:5040

# Load the sample landing page on first start (set to false for a real site).
SEED_DEMO_CONTENT=true
